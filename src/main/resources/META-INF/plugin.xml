<idea-plugin>
    <id>org.intellij.sdk.language</id>
    <name>Harbour Language Support</name>
    <version>1.0.520</version>
    <vendor email="support@example.com" url="http://www.example.com">Harbour Development</vendor>

    <description><![CDATA[
      Comprehensive Harbour language support for IntelliJ Platform IDEs (PyCharm, IntelliJ IDEA).
      
      Features:
      • Advanced syntax highlighting with colour customization
      • Intelligent code completion for functions, methods, and variables
      • Go-to-declaration with external documentation links
      • Full debugging support with breakpoints and variable inspection
      • Code formatting and auto-indentation
      • Structure view and navigation popup
      • Include file resolution and reference support
      • Function classification and error detection
      • Custom notification system for browser configuration
      
      Supports .prg and .ch file extensions with comprehensive Harbour syntax support.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType name="Harbour File" implementationClass="org.intellij.sdk.language.HarbourFileType"
                  fieldName="INSTANCE" language="Harbour" extensions="prg;ch"/>

        <!-- Language -->
        <lang.parserDefinition language="Harbour"
                               implementationClass="org.intellij.sdk.language.HarbourParserDefinition"/>

        <!-- Syntax Highlighter -->
        <lang.syntaxHighlighterFactory language="Harbour"
                                       implementationClass="org.intellij.sdk.language.HarbourSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage implementation="org.intellij.sdk.language.HarbourColorSettingsPage"/>

        <!-- Code Style Settings -->
        <langCodeStyleSettingsProvider implementation="org.intellij.sdk.language.HarbourLanguageCodeStyleSettingsProvider"/>
        <codeStyleSettingsProvider implementation="org.intellij.sdk.language.HarbourCodeStyleSettingsProvider"/>

        <!-- Commenter -->
        <lang.commenter language="Harbour" implementationClass="org.intellij.sdk.language.HarbourCommenter"/>

        <!-- Quote Handler -->
        <lang.quoteHandler language="Harbour" implementationClass="org.intellij.sdk.language.HarbourQuoteHandler"/>

        <!-- Brace Matcher -->
        <lang.braceMatcher language="Harbour" implementationClass="org.intellij.sdk.language.HarbourBraceMatcher"/>

        <!-- Smart Backspace Handler -->
        <backspaceHandlerDelegate implementation="org.intellij.sdk.language.HarbourBackspaceHandler"/>

        <!-- Code Completion -->
        <completion.contributor language="Harbour"
                                implementationClass="org.intellij.sdk.language.HarbourCompletionContributor"/>

        <!-- Reference Contributors - Only existing classes -->
        <psi.referenceContributor language="Harbour" implementation="org.intellij.sdk.language.HarbourIncludeReferenceContributor"/>
        <psi.referenceContributor language="Harbour" implementation="org.intellij.sdk.language.HarbourMethodReferenceContributor"/>
        <psi.referenceContributor language="Harbour" implementation="org.intellij.sdk.language.HarbourClassMethodReferenceContributor"/>
        <psi.referenceContributor language="Harbour" implementation="org.intellij.sdk.language.DirectHarbourReferenceContributor"/>
        <psi.referenceContributor language="Harbour" implementation="org.intellij.sdk.language.HarbourDirectIncludeReferenceContributor"/>

        <!-- Annotators -->
        <annotator language="Harbour" implementationClass="org.intellij.sdk.language.HarbourFunctionCallAnnotator"/>
        <annotator language="Harbour" implementationClass="org.intellij.sdk.language.HarbourIncludeAnnotator"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory language="Harbour"
                                      implementationClass="org.intellij.sdk.language.HarbourStructureViewFactory"/>

        <!-- Go to Declaration -->
        <gotoDeclarationHandler implementation="org.intellij.sdk.language.HarbourGoToDeclarationHandler" order="first"/>
        <gotoDeclarationHandler implementation="org.intellij.sdk.language.HarbourExternalDocumentationHandler" order="last"/>

        <!-- Documentation Provider -->
        <lang.documentationProvider language="Harbour"
                                    implementationClass="org.intellij.sdk.language.HarbourDocumentationProvider"/>

        <!-- Settings Service -->
        <projectService serviceImplementation="org.intellij.sdk.language.HarbourSettings"/>
        
        <!-- Breakpoint Properties Storage Service -->
        <projectService serviceImplementation="org.intellij.sdk.language.HarbourBreakpointPropertiesStorage"/>
        
        <!-- Function Classification Service -->
        <projectService serviceImplementation="org.intellij.sdk.language.HarbourFunctionClassificationService"/>
        
        <!-- Startup Activities -->
        <startupActivity implementation="org.intellij.sdk.language.HarbourFunctionClassificationService$Initializer"/>
        <startupActivity implementation="org.intellij.sdk.language.HarbourReferenceService$HarbourReferenceServiceInitializer"/>

        <!-- Settings -->
        <applicationConfigurable parentId="tools" instance="org.intellij.sdk.language.HarbourApplicationSettingsConfigurable"
                                 id="org.intellij.sdk.language.HarbourSettingsConfigurable"
                                 displayName="Harbour"/>

        <!-- Debug Support -->
        <configurationType implementation="org.intellij.sdk.language.HarbourDebuggerConfigType"/>
        <programRunner implementation="org.intellij.sdk.language.HarbourDebuggerRunner" id="HarbourDebuggerRunner" order="first"/>
        <xdebugger.breakpointType implementation="org.intellij.sdk.language.HarbourDebuggerLineBreakpointType"/>
        
        <!-- Windows-specific registration fix -->
        <projectActivity implementation="org.intellij.sdk.language.HarbourDebuggerRunnerRegistration"/>
        
        <!-- Console Filter for clickable error messages -->
        <consoleFilterProvider implementation="org.intellij.sdk.language.HarbourConsoleFilterProvider"/>
        
        <!-- Formatting -->
        <lang.formatter language="Harbour" implementationClass="org.intellij.sdk.language.HarbourFormattingModelBuilder"/>
        <postFormatProcessor implementation="org.intellij.sdk.language.HarbourPostFormatProcessor"/>
        
        <!-- Rename -->
        <renamePsiElementProcessor implementation="org.intellij.sdk.language.HarbourRenameProcessor"/>
        <renameHandler implementation="org.intellij.sdk.language.HarbourRenameHandler"/>
        
        <!-- Enter Handler for auto-indentation -->
        <enterHandlerDelegate implementation="org.intellij.sdk.language.HarbourEnterHandler"/>
        
        <!-- Typed Handler for end keyword indentation correction -->
        <typedHandler implementation="org.intellij.sdk.language.HarbourTypedHandlerDelegate"/>
        
        <!-- Line Indent Provider for fast auto-indentation - TEMPORARILY DISABLED -->
        <!-- <codeInsight.lineIndentProvider language="Harbour" implementationClass="org.intellij.sdk.language.HarbourLineIndentProvider"/> -->
        
        <!-- Notification Group -->
        <notificationGroup id="Harbour Application" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <!-- Format Action -->
        <action id="HarbourFormatAction" class="org.intellij.sdk.language.HarbourFormatAction"
                text="Format Harbour Code" description="Format Harbour code">
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ReformatCode"/>
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="IntroduceVariable"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift L"/>
        </action>

        <!-- Next Error Action -->
        <action id="HarbourNextErrorAction" class="org.intellij.sdk.language.HarbourNextErrorAction"
                text="Next Harbour Error" description="Go to next Harbour error">
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>

        <!-- REMOVED: HarbourTestErrorAction - obsolete since error handling now works properly -->
    </actions>
</idea-plugin>